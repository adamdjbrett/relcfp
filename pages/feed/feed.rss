---
layout: null
permalink: /feed.rss
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url | xml_escape }}</link>
    <description>{{ site.description | strip | xml_escape }}</description>
    <language>en-US</language>
    <atom:link href="{{ '/feed.rss' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml"/>
    {% for post in site.posts %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url | xml_escape }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url | xml_escape }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
